# Copy to .env and adjust. .env is gitignored; never commit real values.

# Dev database (Postgres.app default: your macOS username, no password)
DATABASE_URL=postgresql://localhost:5432/sayd

# Used by pytest; the test fixture wipes this database, so keep it separate from DATABASE_URL
TEST_DATABASE_URL=postgresql://localhost:5432/sayd_test

# Public URL Twilio posts to (dev tunnel URL, or the production domain)
PUBLIC_BASE_URL=http://localhost:8000